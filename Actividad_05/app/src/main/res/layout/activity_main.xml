<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
    <TextView android:layout_width="match_parent" android:layout_height="56dp" android:background="#303F9F" android:gravity="center_vertical" android:paddingStart="16dp" android:text="TopQuiz" android:textColor="#FFFFFF" android:textSize="18sp"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Welcome! What is your name?" android:textSize="14sp"/>
        <EditText android:id="@+id/inputName" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Please type your name" android:inputType="text" android:layout_marginTop="12dp"/>
        <Button android:id="@+id/btnPlay" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="LET'S PLAY" android:layout_gravity="center" android:layout_marginTop="24dp" android:enabled="false"/>
    </LinearLayout>
</LinearLayout>
