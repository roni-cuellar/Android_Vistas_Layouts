<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
    <TextView android:layout_width="match_parent" android:layout_height="56dp" android:background="#6200EE" android:gravity="center_vertical" android:paddingStart="16dp" android:text="Two Activities" android:textColor="#FFFFFF" android:textSize="18sp"/>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Reply Received" android:layout_marginStart="12dp" android:layout_marginTop="12dp" android:textStyle="bold"/>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="This is my reply" android:id="@+id/replyText" android:layout_marginStart="12dp" android:layout_marginTop="8dp"/>
    <Space android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:padding="8dp">
        <EditText android:id="@+id/inputMessage" android:layout_height="wrap_content" android:hint="Enter Your Message!" android:inputType="text" android:layout_width="0dp" android:layout_weight="1"/>
        <Button android:id="@+id/btnSend" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="SEND"/>
    </LinearLayout>
</LinearLayout>
